{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/order",
      "destination": "/order.html",
      "statusCode": 301
    },
    {
      "source": "/go/lifetime",
      "destination": "https://thelottochamp.com/start/index.php?aff_id=3167",
      "statusCode": 302
    },
    {
      "source": "/go/1",
      "destination": "https://thelottochamp.com/start/index.php?aff_id=3167",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/go/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/order.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/key.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
